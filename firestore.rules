rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isPartnerOwner(partnerId) {
      return isAuthenticated() && request.auth.uid == partnerId;
    }

    function isApprovedPartner() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/market_partners/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/market_partners/$(request.auth.uid)).data.status == 'APPROVED';
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.keys().hasAny(['admin']) && request.auth.token.admin == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN'))
      );
    }

    // Base user document
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin();
    }

    // Market partner profile & KYC data
    match /market_partners/{partnerId} {
      allow read: if isPartnerOwner(partnerId) || isAdmin();
      allow create: if isPartnerOwner(partnerId) || isAdmin();
      allow update: if isPartnerOwner(partnerId) || isAdmin();
    }

    // Products catalog
    match /products/{productId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.partnerId == request.auth.uid &&
        isApprovedPartner();
      allow update: if isAuthenticated() &&
        (resource.data.partnerId == request.auth.uid || isAdmin()) &&
        isApprovedPartner();
      allow delete: if isAuthenticated() &&
        (resource.data.partnerId == request.auth.uid || isAdmin());
    }

    // Orders
    match /orders/{orderId} {
      allow read: if isAuthenticated() &&
        (resource.data.partnerId == request.auth.uid || resource.data.customerId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
        (resource.data.partnerId == request.auth.uid || resource.data.customerId == request.auth.uid || isAdmin());
    }

    // Payout requests
    match /payout_requests/{payoutId} {
      allow read: if isAuthenticated() && (resource.data.partnerId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() &&
        request.resource.data.partnerId == request.auth.uid &&
        isApprovedPartner();
      allow update: if isAdmin(); // Admin updates status
    }

    // Partner notifications (both collection name conventions supported)
    match /partner_notifications/{notifId} {
      allow read: if isAuthenticated() && (resource.data.partnerId == request.auth.uid || resource.data.recipientPartnerId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (resource.data.partnerId == request.auth.uid || resource.data.recipientPartnerId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
    }

    match /market_partner_notifications/{notifId} {
      allow read: if isAuthenticated() && (resource.data.partnerId == request.auth.uid || resource.data.recipientPartnerId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (resource.data.partnerId == request.auth.uid || resource.data.recipientPartnerId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
    }

    // Outbound notifications
    match /customer_notifications/{notifId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && (resource.data.customerId == request.auth.uid || isAdmin());
    }

    match /delivery_notifications/{notifId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && (resource.data.deliveryPartnerId == request.auth.uid || isAdmin());
    }

    match /admin_notifications/{notifId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin();
      allow update: if isAdmin();
    }

    // Approved Delivery Partners (for dispatch assignment)
    match /delivery_partners/{partnerId} {
      allow read: if isAuthenticated();
    }

    // Master Local Areas (Admin controlled, readable by prospective partners & public)
    match /localAreas/{areaId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Master Service Areas (Admin controlled, readable by prospective partners & public)
    match /serviceAreas/{areaId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /service_areas/{areaId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Master Category Configurations (Global enable/disable from Super Admin)
    match /categories_config/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isAuthenticated();
    }

    // Area change requests from partners
    match /area_change_requests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
  }
}
